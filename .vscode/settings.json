{
  "dart.lineLength": 120,
  "files.insertFinalNewline": true,
  "java.configuration.updateBuildConfiguration": "interactive",
  "cmake.configureOnOpen": false,
  "search.exclude": {
    "**/.fvm": true,
    "**/.pub": true,
    "**/.dart_tool": true,
    "**/.idea": true,
    "**/.firebase": true,
    "**/build": true,
    "**/ios": true,
    "**/android": true,
    "**/macos": true,
    "**/web": true,
    "**/coverage": true,
    "**/packages/neon": true
  },
  "files.watcherExclude": {
    "**/.fvm": true,
    "**/.pub": true,
    "**/.dart_tool": true,
    "**/.firebase": true,
    "**/build": true,
    "**/ios": true,
    "**/android": true,
    "**/macos": true,
    "**/web": true,
    "**/coverage": true,
    "**/packages/neon": true
  },
  "dart.flutterSdkPath": ".fvm/versions/3.38.9",
  "deno.enablePaths": [
    "supabase/functions"
  ],
  "deno.lint": true,
  "deno.unstable": [
    "bare-node-builtins",
    "byonm",
    "sloppy-imports",
    "unsafe-proto",
    "webgpu",
    "broadcast-channel",
    "worker-options",
    "cron",
    "kv",
    "ffi",
    "fs",
    "http",
    "net"
  ],
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  }
}
